<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ücretli Apple geliştirici hesabıyla: QR bağlantıları uygulamada açılsın. Alan adını yaz, sonra Xcode'da
	     Signing & Capabilities > + Capability > Associated Domains ekle ve bu dosyayı seç. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:yazboz101.com</string>
	</array>
</dict>
</plist>
